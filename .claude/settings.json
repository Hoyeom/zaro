{
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push -f origin main*)",
      "Bash(git push --force origin main*)",
      "Bash(*--no-verify*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push origin HEAD:main*)",
      "PowerShell(*--no-verify*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/lint.py", "--hook"],
            "timeout": 30,
            "statusMessage": "zaro-lint"
          }
        ]
      }
    ]
  }
}
